# agent-core: copiá a .env y completá.
# LLM principal: Ollama Cloud (https://ollama.com)
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=nemotron-3-nano:30b

# Secret compartido inter-servicios (el MISMO valor en los tres .env).
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=

# Ollama LOCAL para embeddings de la capa semántica.
# Default: qwen3-embedding:0.6b (1024 dims). Ajustá OLLAMA_EMBED_DIM si
# cambiás de modelo.
# OLLAMA_LOCAL_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# OLLAMA_EMBED_DIM=1024

# Loop agéntico
# AGENT_MAX_TOOL_ROUNDS=15
# AGENT_MAX_SEGMENTS=3

# Memoria (TTL y cantidades inyectadas al prompt)
# MEMORY_TTL_DAYS=30
# MEMORY_EPISODES_IN_CONTEXT=8
# MEMORY_SEMANTIC_TOP_K=5
# MEMORY_FACTS_IN_CONTEXT=30

# URLs de los demás servicios
# GATEWAY_URL=http://localhost:3200
# EXECUTOR_URL=http://localhost:3100
# PORT=3000
# BIND_HOST=127.0.0.1