# Telegram gateway: copiá a .env y completá.
TELEGRAM_BOT_TOKEN=

# Allowlist de usuarios de Telegram (ids numéricos separados por coma).
# En producción es OBLIGATORIO: vacío = acepta cualquier usuario.
ALLOWED_TELEGRAM_USER_IDS=

# URLs de los demás servicios
AGENT_CORE_URL=http://localhost:3000
EXECUTOR_URL=http://localhost:3100

# Secret compartido inter-servicios (el MISMO valor en los tres .env)
INTERNAL_API_KEY=

# Opcionales:
# GATEWAY_PORT=3200
# GATEWAY_DATA_DIR=data
# GATEWAY_SKIP_BACKLOG=true
# GATEWAY_DISPATCH_POLL_MS=1000
# GATEWAY_MAX_BACKOFF_MS=30000
# GATEWAY_ARTIFACTS_DIR=../executor/data/sandbox
# BIND_HOST=127.0.0.1