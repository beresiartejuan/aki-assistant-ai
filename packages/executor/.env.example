# Executor: copiá a .env y completá.
# El secret INTERNAL_API_KEY debe ser EL MISMO en los .env de los tres
# servicios (agent-core, executor, telegram-gateway). Generar con:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# Modo del sandbox: docker (recomendado) | process (dev inseguro, host)
EXECUTOR_SANDBOX_MODE=docker

# Directorio de workspaces por tarea
EXECUTOR_DATA_DIR=data/sandbox

# Imagen del sandbox (build: docker build -f packages/executor/docker/sandbox.Dockerfile -t aki-sandbox:latest packages/executor/docker/)
EXECUTOR_SANDBOX_IMAGE=aki-sandbox:latest

# Red del contenedor: none | bridge | host
EXECUTOR_NETWORK_MODE=bridge

# Opcionales:
# EXECUTOR_CONTAINER_MEMORY=2147483648
# EXECUTOR_CONTAINER_CPUS=0
# EXECUTOR_DEFAULT_TIMEOUT_MS=15000
# EXECUTOR_MAX_TIMEOUT_MS=120000
# EXECUTOR_MAX_OUTPUT_CHARS=10000
# EXECUTOR_MAX_CONCURRENT=4
# BIND_HOST=127.0.0.1